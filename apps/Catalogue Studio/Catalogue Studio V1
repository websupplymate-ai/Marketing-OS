        headers: {
          'Authorization': 'Bearer ' + env.REPLICATE_API_TOKEN,
          'Content-Type': 'application/json',
          'Prefer': 'wait'
        },
        body: JSON.stringify({ version, input })
      });

      let pred = await start.json();
      if (pred.error) return json({ error: pred.error }, 502);

      // 'Prefer: wait' usually returns a finished prediction; poll if not.
      let tries = 0;
      while (pred.status !== 'succeeded' && pred.status !== 'failed' && tries < 60) {
        await new Promise(r => setTimeout(r, 1500));
        const p = await fetch(pred.urls.get, {
          headers: { 'Authorization': 'Bearer ' + env.REPLICATE_API_TOKEN }
        });
        pred = await p.json();
        tries++;
      }

      if (pred.status !== 'succeeded') {
        return json({ error: pred.error || 'Prediction ' + pred.status }, 502);
      }

      const out = Array.isArray(pred.output) ? pred.output[0] : pred.output;
      return json({ image: out });

    } catch (err) {
      return json({ error: err.message }, 500);
    }
  }
};

function json(obj, status = 200) {
  return new Response(JSON.stringify(obj), {
    status,
    headers: { 'Content-Type': 'application/json', ...CORS }
  });
}`;

/* ═══════════ WIRING ═══════════ */
document.addEventListener('DOMContentLoaded', async () => {
  $('workerCode').textContent = WORKER_SRC;

  await Store.init();
  await restore();
  renderAll();

  // Nav
  document.querySelectorAll('.sb-item').forEach(el => el.onclick = () => {
    document.querySelectorAll('.sb-item').forEach(x => x.classList.remove('active'));
    el.classList.add('active');
    const p = el.dataset.page;
    document.querySelectorAll('.page').forEach(x => x.classList.remove('active'));
    $('page-' + p).classList.add('active');
    $('crumb').textContent = el.textContent.replace(/\d+$/, '').trim();
    renderAll();
  });

  $('themeBtn').onclick = () => {
    const h = document.documentElement;
    h.dataset.theme = h.dataset.theme === 'dark' ? 'light' : 'dark';
  };

  // Config bindings
  const bind = (id, key, fn) => { const e = $(id); e.oninput = e.onchange = async () => { S.cfg[key] = fn ? fn(e.value) : e.value; await persist(); }; };
  bind('cfgEndpoint', 'endpoint'); bind('cfgProvider', 'provider');
  bind('cfgAspect', 'aspect'); bind('cfgSize', 'size', Number); bind('cfgFormat', 'format');
  bind('cfgWmPos', 'wmPos');
  $('cfgWmOp').oninput = async e => { S.cfg.wmOp = +e.target.value; $('wmOpVal').textContent = S.cfg.wmOp + '%'; await persist(); };
  $('cfgWmSz').oninput = async e => { S.cfg.wmSz = +e.target.value; $('wmSzVal').textContent = S.cfg.wmSz + '%'; await persist(); };
  $('cfgTol').oninput = async e => { S.cfg.tol = +e.target.value; $('tolVal').textContent = S.cfg.tol; await persist(); };
  $('cfgCutout').onchange = async e => { S.cfg.cutout = e.target.value; $('tolField').style.display = e.target.value === 'quick' ? '' : 'none'; await persist(); };

  $('copyWorker').onclick = async () => {
    try { await navigator.clipboard.writeText(WORKER_SRC); toast('Worker code copied'); }
    catch { toast('Copy failed — select the code manually'); }
  };

  $('testEndpoint').onclick = async () => {
    const st = $('endpointState');
    if (!S.cfg.endpoint) { st.className = 'badge red'; st.textContent = 'No URL set'; return; }
    st.className = 'badge amber'; st.textContent = 'Testing…';
    try {
      const r = await fetch(S.cfg.endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ op: 'ping' }) });
      st.className = r.status < 500 ? 'badge green' : 'badge red';
      st.textContent = r.status < 500 ? 'Reachable' : 'Server error ' + r.status;
    } catch (e) { st.className = 'badge red'; st.textContent = 'Unreachable'; }
  };

  // Cast
  $('genFace').onclick = async () => {
    const gender = $('genGender').value, age = +$('genAge').value, vertical = $('genVertical').value;
    const btn = $('genFace');
    btn.disabled = true; btn.textContent = 'Generating…';
    const prompt = `studio portrait headshot of an Indian ${gender}, ${age} years old, `
      + `neutral friendly expression, facing camera straight on, even soft front lighting, `
      + `plain light grey seamless background, sharp focus, photorealistic, no text`;
    try {
      const src = await callApi('generate', { prompt });
      const n = S.faces.filter(f => f.gender === gender).length + 1;
      S.faces.push({
        id: uid(),
        name: `${gender === 'man' ? 'Model M' : 'Model F'}${n}`,
        src, vertical, gender, age
      });
      await persist(); renderFaces(); renderIntake();
      toast('Identity added — rename it to something you\'ll remember');
    } catch (e) {
      toast(e.message);
    }
    btn.disabled = false; btn.textContent = 'Generate';
  };

  wireDrop('dzFaces', 'image/*', async files => {
    for (const f of files) {
      S.faces.push({
        id: uid(), name: f.name.replace(/\.[^.]+$/, ''), src: await fileToDataURL(f),
        vertical: $('genVertical').value, gender: $('genGender').value, age: +$('genAge').value
      });
    }
    await persist(); renderFaces(); renderIntake(); toast(`${files.length} identity added`);
  });

  $('bulkFace').onchange = async e => {
    if (!e.target.value) return;
    S.items.forEach(i => { if (i.stage === 'intake') i.faceId = e.target.value; });
    const f = S.faces.find(x => x.id === e.target.value);
    e.target.value = '';
    await persist(); renderIntake(); renderFaces();
    toast(`Whole batch set to ${f.name}`);
  };
  wireDrop('dzBackdrops', 'image/*', async files => {
    for (const f of files) S.backdrops.push({ id: uid(), name: f.name.replace(/\.[^.]+$/, ''), src: await fileToDataURL(f), vertical: 'Any' });
    await persist(); renderBackdrops(); toast(`${files.length} backdrop added`);
  });
  wireDrop('dzLogo', 'image/*', async files => {
    S.logo = await fileToDataURL(files[0]); await persist(); renderLogo(); toast('Logo loaded');
  });
  wireDrop('dzProducts', 'image/*', async files => {
    const ind = $('inIndustry').value;
    const chosenFace = $('inFace').value;
    const face = chosenFace ? S.faces.find(f => f.id === chosenFace) : castFor(ind);
    const pool = batch.pool.length ? batch.pool
               : S.backdrops.filter(b => b.vertical === ind).map(b => b.id);
    const mode = $('inBdMode').value;
    let n = +$('inSerial').value || 1;

    for (let k = 0; k < files.length; k++) {
      let bdId = '';
      if (pool.length) {
        bdId = mode === 'random' ? pool[Math.floor(Math.random() * pool.length)]
             : mode === 'first'  ? pool[0]
             : pool[k % pool.length];
      }
      S.items.push({
        id: uid(), stage: 'intake', status: 'pending',
        title: files[k].name.replace(/\.[^.]+$/, '').replace(/[_-]+/g, ' '),
        sku: currentSku(n++),
        vertical: ind, faceId: face?.id || null, bdId,
        src: await fileToDataURL(files[k]), out: null, approved: undefined, error: ''
      });
    }
    $('inSerial').value = n;
    syncSkuField();
    await persist(); renderAll(); toast(`${files.length} photographs added`);
  });

  // Delegated events
  document.body.addEventListener('click', async e => {
    const t = e.target;
    if (t.dataset.del === 'face') { S.faces = S.faces.filter(f => f.id !== t.dataset.id); await persist(); renderFaces(); }
    if (t.dataset.del === 'bd') { S.backdrops = S.backdrops.filter(b => b.id !== t.dataset.id); await persist(); renderBackdrops(); }
    if (t.dataset.rm) { S.items = S.items.filter(i => i.id !== t.dataset.rm); await persist(); renderAll(); }
    if (t.dataset.ok) { const i = S.items.find(x => x.id === t.dataset.ok); i.approved = true; await persist(); renderReview(); renderCounts(); renderExport(); }
    if (t.dataset.no) { const i = S.items.find(x => x.id === t.dataset.no); i.approved = false; await persist(); renderReview(); renderCounts(); renderExport(); }
    if (t.dataset.retry) { const i = S.items.find(x => x.id === t.dataset.retry); i.status = 'pending'; i.error = ''; renderProcess(); toast('Requeued — run the batch again'); }
  });
  document.body.addEventListener('change', async e => {
    const t = e.target;
    if (t.dataset.bdvert) { S.backdrops.find(b => b.id === t.dataset.bdvert).vertical = t.value; await persist(); }
    if (t.dataset.fvert) { S.faces.find(f => f.id === t.dataset.fvert).vertical = t.value; await persist(); renderIntake(); }
    if (t.dataset.face) { S.items.find(i => i.id === t.dataset.face).faceId = t.value; await persist(); }
    if (t.dataset.bd) { S.items.find(i => i.id === t.dataset.bd).bdId = t.value; await persist(); }
  });
  document.body.addEventListener('input', async e => {
    const t = e.target;
    if (t.dataset.title) { S.items.find(i => i.id === t.dataset.title).title = t.value; }
    if (t.dataset.sku) { S.items.find(i => i.id === t.dataset.sku).sku = t.value; }
    if (t.dataset.fname) { S.faces.find(f => f.id === t.dataset.fname).name = t.value; await persist(); }
  });

  $('clearBatch').onclick = async () => {
    S.items = S.items.filter(i => i.stage !== 'intake');
    await persist(); renderAll(); toast('Batch cleared');
  };
  $('sendToProcess').onclick = async () => {
    const n = S.items.filter(i => i.stage === 'intake').length;
    if (!n) return toast('Nothing in the batch');
    S.items.forEach(i => { if (i.stage === 'intake') i.stage = 'process'; });
    await persist(); renderAll(); toast(`${n} sent to processing`);
  };

  $('startRun').onclick = runBatch;
  $('stopRun').onclick = () => { running = false; toast('Stopping after current image'); };

  $('approveAll').onclick = async () => {
    S.items.filter(i => i.status === 'done' && i.approved === undefined).forEach(i => i.approved = true);
    await persist(); renderReview(); renderCounts(); renderExport(); toast('All approved');
  };
  $('filterToggle').onclick = () => {
    S.reviewFilter = S.reviewFilter === 'pending' ? 'all' : 'pending';
    $('filterToggle').textContent = S.reviewFilter === 'pending' ? 'Show all' : 'Show pending only';
    renderReview();
  };

  $('dlImages').onclick = downloadImages;
  $('dlCsv').onclick = buildCsv;

  // ── SKU section ──
  document.querySelectorAll('.subtab').forEach(el => el.onclick = () => {
    document.querySelectorAll('.subtab').forEach(x => x.classList.remove('active'));
    el.classList.add('active');
    document.querySelectorAll('.subview').forEach(x => x.classList.remove('active'));
    $('sv-' + el.dataset.sv).classList.add('active');
  });

  renderDicts(); renderSkuRows();

  document.body.addEventListener('click', async e => {
    const t = e.target;
    if (t.dataset.addrow) {
      const d = t.dataset.addrow;
      const blank = { industries: { code: '', label: '', group: 'WW' },
                      types: { code: '', label: '', match: '' },
                      colours: { code: '', label: '', hex: '#888888', match: '' } }[d];
      S.sku[d].push({ ...blank });
      await persist(); renderDicts();
    }
    if (t.dataset.drop) {
      S.sku[t.dataset.drop].splice(+t.dataset.i, 1);
      await persist(); renderDicts();
    }
  });

  document.body.addEventListener('input', async e => {
    const t = e.target;
    if (t.dataset.d) {
      let v = t.value;
      if (t.dataset.f === 'code') v = v.toUpperCase().replace(/[^A-Z]/g, '').slice(0, 3);
      S.sku[t.dataset.d][+t.dataset.i][t.dataset.f] = v;
      if (t.dataset.f === 'code') { t.value = v; clearTimeout(window._ct); window._ct = setTimeout(renderDicts, 700); }
      await persist();
    }
  });

  document.body.addEventListener('change', async e => {
    const t = e.target;
    if (t.dataset.also !== undefined) {
      const r = S.sku.rows[+t.dataset.also];
      r.also = r.also || [];
      r.also = t.checked ? [...new Set([...r.also, t.value])] : r.also.filter(x => x !== t.value);
      await persist();
      const sum = t.closest('details').querySelector('summary');
      sum.textContent = r.also.length ? r.also.join(', ') : '— none —';
    }
    if (t.dataset.srow !== undefined && t.dataset.sf) {
      const r = S.sku.rows[+t.dataset.srow];
      r[t.dataset.sf] = t.value;
      r.code = buildCode(r);
      await persist(); renderSkuRows();
    }
    if (t.dataset.d && t.dataset.f === 'group') {
      S.sku[t.dataset.d][+t.dataset.i].group = t.value;
      await persist(); renderDicts();
    }
  });

  // ── Intake batch controls ──
  ['inType', 'inFit', 'inColour', 'inSerial'].forEach(id => {
    $(id).oninput = $(id).onchange = syncSkuField;
  });
  $('inIndustry').onchange = () => { renderBdPool(); syncSkuField(); };
  $('inSku').oninput = skuFieldTyped;
  $('inBdMode').onchange = () => {};
  document.body.addEventListener('change', e => {
    if (e.target.dataset.bdpool) {
      const id = e.target.dataset.bdpool;
      batch.pool = e.target.checked ? [...batch.pool, id] : batch.pool.filter(x => x !== id);
      renderBdPool();
    }
  });
  $('castFilter').onchange = renderFaces;
  $('bdFilter').onchange = renderBackdrops;
  renderBatchControls();

  $('masterCode').textContent = MASTER_SRC;
  $('copyMaster').onclick = async () => {
    try { await navigator.clipboard.writeText(MASTER_SRC); toast('Apps Script copied'); }
    catch { toast('Copy failed — select the code manually'); }
  };
  $('mSheetUrl').oninput = async e => { S.cfg.sheetUrl = e.target.value.trim(); await persist(); };
  $('mPull').onclick = masterPull;
  $('mPush').onclick = masterPush;
  $('mSearch').oninput = renderMaster;
  $('mCsv').onclick = masterCsv;
  $('dlDrive').onclick = driveUpload;
  renderMaster();

  $('skuGenerate').onclick = generateSkus;
  $('skuCsv').onclick = skuCsv;
  $('skuFactory').onclick = factorySheet;
  $('skuClear').onclick = async () => {
    if (!S.sku.rows.length) return;
    S.sku.rows = []; await persist(); renderSkuRows(); toast('Codes cleared');
  };
});
</script>
</body>
</html>
