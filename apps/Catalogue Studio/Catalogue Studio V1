/* ═══════════ SKU MODULE ═══════════ */

const PAD = n => String(n).padStart(4, '0');
const words = s => (s || '').split(',').map(x => x.trim().toLowerCase()).filter(Boolean);

/* Types: longest match wins, so "chef coat" beats "coat".
   Colours: earliest match wins, so "Black & Yellow Vest Coat" reads as black. */
function detect(name, dict, preferEarliest) {
  const low = ' ' + name.toLowerCase().replace(/[^a-z0-9]+/g, ' ') + ' ';
  let best = null, bestLen = 0, bestPos = Infinity;
  for (const entry of dict) {
    for (const w of words(entry.match)) {
      const base = w.replace(/[^a-z0-9]+/g, ' ');
      for (const form of [base, base + 's', base + 'es']) {
        const pos = low.indexOf(' ' + form + ' ');
        if (pos === -1) continue;
        const better = preferEarliest
          ? (pos < bestPos || (pos === bestPos && w.length > bestLen))
          : (w.length > bestLen);
        if (better) { best = entry; bestLen = w.length; bestPos = pos; }
        break;
      }
    }
  }
  return best;
}

/* Two codes that differ by a single character in the same segment are a floor-error waiting
   to happen. Flag them so they can be edited before 780 labels get printed. */
function findClashes(dict) {
  const out = [];
  for (let i = 0; i < dict.length; i++) {
    for (let j = i + 1; j < dict.length; j++) {
      const a = (dict[i].code || '').toUpperCase(), b = (dict[j].code || '').toUpperCase();
      if (a.length !== b.length || !a) continue;
      let diff = 0, pos = -1;
      for (let k = 0; k < a.length; k++) if (a[k] !== b[k]) { diff++; pos = k; }
      if (diff === 1) {
        const pair = [a[pos], b[pos]].sort().join('');
        const risky = ['DO', 'CG', 'EF', 'MN', 'OQ', 'PR', 'UV', 'IJ', 'BR', 'CO', 'DP'];
        out.push({ a, b, risky: risky.includes(pair) });
      }
    }
  }
  return out;
}

function nextSerial(group, ind, type) {
  const prefix = `${group}-${ind}-${type}-`;
  const used = S.sku.rows
    .filter(r => r.code.startsWith(prefix))
    .map(r => parseInt(r.code.slice(prefix.length, prefix.length + 4), 10))
    .filter(n => !isNaN(n));
  return used.length ? Math.max(...used) + 1 : 1;
}

function buildCode(r) {
  const ind = S.sku.industries.find(i => i.code === r.ind);
  return `${ind ? ind.group : '??'}-${r.ind || '???'}-${r.type || '???'}-${PAD(r.serial)}-${r.fit || '???'}-${r.colour || '???'}`;
}

/* Reverse of buildCode — lets the intake field accept a typed SKU and fill the dropdowns. */
function parseCode(code) {
  const p = (code || '').toUpperCase().trim().split('-');
  if (p.length !== 6) return null;
  const [group, ind, type, serial, fit, colour] = p;
  const industry = S.sku.industries.find(i => i.code === ind);
  if (!industry || industry.group !== group) return null;
  if (!S.sku.types.some(t => t.code === type)) return null;
  if (!S.sku.fits.some(f => f.code === fit)) return null;
  if (!S.sku.colours.some(c => c.code === colour)) return null;
  if (!/^\d{4}$/.test(serial)) return null;
  return { ind, type, serial: parseInt(serial, 10), fit, colour };
}

