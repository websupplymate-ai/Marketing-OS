    <td class="x"><button data-drop="types" data-i="${i}">×</button></td></tr>`).join('');

  $('dictFits').innerHTML = S.sku.fits.map((r, i) => `
    <tr><td><input class="code" maxlength="3" value="${esc(r.code)}" data-d="fits" data-i="${i}" data-f="code"></td>
