const Store = (() => {
  let db = null, ok = false;
  const mem = new Map();
  async function init() {
    try {
      db = await new Promise((res, rej) => {
        const r = indexedDB.open('sm_catalogue_v1', 1);
        r.onupgradeneeded = e => { const d = e.target.result; if (!d.objectStoreNames.contains('kv')) d.createObjectStore('kv'); };
        r.onsuccess = e => res(e.target.result);
        r.onerror = () => rej(r.error);
        setTimeout(() => rej(new Error('timeout')), 3000);
      });
      ok = true;
    } catch { ok = false; }
    const el = document.getElementById('storeState');
    if (el) el.textContent = ok ? 'persisted' : 'session only';
    return ok;
  }
  function tx(mode) { return db.transaction('kv', mode).objectStore('kv'); }
  async function get(k) {
    if (!ok) return mem.get(k) ?? null;
    try { return await new Promise((res, rej) => { const r = tx('readonly').get(k); r.onsuccess = () => res(r.result ?? null); r.onerror = () => rej(r.error); }); }
    catch { return mem.get(k) ?? null; }
  }
  async function set(k, v) {
    mem.set(k, v);
    if (!ok) return;
    try { await new Promise((res, rej) => { const r = tx('readwrite').put(v, k); r.onsuccess = res; r.onerror = () => rej(r.error); }); } catch {}
  }
  return { init, get, set };
})();

