/* ═══════════ DROPZONES ═══════════ */
function wireDrop(id, accept, onFiles) {
  const dz = $(id);
  const input = document.createElement('input');
  input.type = 'file'; input.accept = accept; input.multiple = true; input.style.display = 'none';
  document.body.appendChild(input);
  dz.onclick = () => input.click();
  input.onchange = () => { if (input.files.length) onFiles([...input.files]); input.value = ''; };
  dz.ondragover = e => { e.preventDefault(); dz.classList.add('over'); };
  dz.ondragleave = () => dz.classList.remove('over');
  dz.ondrop = e => {
    e.preventDefault(); dz.classList.remove('over');
    const f = [...e.dataTransfer.files].filter(x => x.type.startsWith('image/'));
    if (f.length) onFiles(f);
  };
}

/* ═══════════ PIPELINE ═══════════ */
let running = false;
async function runBatch() {
  const queue = S.items.filter(i => i.stage === 'process' && i.status !== 'done');
  if (!queue.length) return toast('Nothing queued to run');
  if ($('stepSwap').checked && !S.faces.length) return toast('Add a model identity in Setup first');
  running = true;
  $('startRun').disabled = true; $('stopRun').disabled = false;
  let n = 0;
  for (const it of queue) {
    if (!running) break;
    it.status = 'running'; it.error = ''; renderProcess();
    $('runStatus').textContent = `Processing ${it.title} — ${n + 1} of ${queue.length}`;
    try {
      let work = it.src;
      if ($('stepSwap').checked) {
        const face = S.faces.find(f => f.id === it.faceId) || S.faces[0];
        work = await callApi('faceswap', { source: face.src, target: work });
      }
      if ($('stepCut').checked) {
        work = S.cfg.cutout === 'api'
          ? await callApi('cutout', { image: work })
          : await quickCutout(work, S.cfg.tol);
      }
      const opts = {
        aspect: S.cfg.aspect, size: +S.cfg.size, format: S.cfg.format,
        logo: $('stepWm').checked ? S.logo : null, wmPos: S.cfg.wmPos, wmOp: S.cfg.wmOp, wmSz: S.cfg.wmSz
      };
      const bd = S.backdrops.find(b => b.id === it.bdId);
      it.out = ($('stepBd').checked && bd) ? await compose(work, bd.src, opts) : await fitOnly(work, opts);
      it.status = 'done'; it.approved = undefined;
    } catch (e) {
      it.status = 'error'; it.error = e.message;
    }
    n++;
    $('runBar').style.width = Math.round(n / queue.length * 100) + '%';
    renderProcess(); renderCounts();
  }
  running = false;
  $('startRun').disabled = false; $('stopRun').disabled = true;
  $('runStatus').textContent = `Finished — ${S.items.filter(i => i.status === 'done').length} done, ${S.items.filter(i => i.status === 'error').length} failed`;
  await persist(); renderAll();
  toast('Batch complete');
}

