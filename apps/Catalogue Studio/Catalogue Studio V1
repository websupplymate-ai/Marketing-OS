async function driveUpload() {
  const url = S.cfg.sheetUrl;
  if (!url) return toast('Add your Apps Script URL in Setup \u2192 Product master first');
  const ok = S.items.filter(i => i.approved === true);
  if (!ok.length) return toast('Approve some images first');
  const ext = S.cfg.format === 'image/png' ? 'png' : 'jpg';
  let done = 0, failed = 0;
  $('driveState').className = 'badge amber';

  for (const it of ok) {
    $('driveState').textContent = `Uploading ${done + 1} of ${ok.length}`;
    try {
      const r = await fetch(url, {
        method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({
          action: 'upload',
          filename: `${it.sku}.${ext}`,
          mimeType: S.cfg.format,
          data: it.out.split(',')[1]
        })
      });
      const j = await r.json();
      if (!j.ok) throw new Error(j.error || 'upload failed');
      // Write the link onto the matching master row, creating it if the SKU is new.
      let m = S.master.find(x => x.sku === it.sku);
      if (!m) { m = { sku: it.sku, name: it.title, status: 'draft' }; S.master.push(m); }
      m.image = j.url;
      m.updated = new Date().toISOString().slice(0, 10);
      done++;
    } catch (e) { failed++; }
    $('driveBar').style.width = Math.round((done + failed) / ok.length * 100) + '%';
  }
  await persist(); renderMaster();
  $('driveState').className = failed ? 'badge amber' : 'badge green';
  $('driveState').textContent = failed ? `${done} up, ${failed} failed` : `${done} uploaded`;
  toast(failed ? `${done} uploaded, ${failed} failed` : `${done} images on Drive`);
}

