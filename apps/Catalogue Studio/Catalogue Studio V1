function renderSkuRows() {
  const rows = S.sku.rows;
  $('skuResultCard').style.display = rows.length ? '' : 'none';
  if (!rows.length) return;

  const missing = rows.filter(r => !r.type || !r.colour).length;
  const dupes = {};
  rows.forEach(r => { dupes[r.code] = (dupes[r.code] || 0) + 1; });
  const dupCount = Object.values(dupes).filter(n => n > 1).length;

  /* Same garment, different industry — the white-shirt problem. Two rows sharing
     type + fit + colour under different industries are almost certainly one product. */
  const sig = {};
  rows.forEach((r, i) => {
    if (!r.type || !r.colour || r.ind === 'GEN') return;
    const k = `${r.type}|${r.fit}|${r.colour}`;
    (sig[k] = sig[k] || []).push(i);
  });
  const twins = Object.entries(sig)
    .filter(([, ix]) => new Set(ix.map(i => rows[i].ind)).size > 1)
    .map(([k, ix]) => ({ k, ix }));

  $('skuSummary').textContent = `${rows.length} codes across ${new Set(rows.map(r => r.ind)).size} industries`;
  $('skuFlags').innerHTML = [
    missing ? `<div class="note" style="margin-bottom:8px"><strong>${missing} row${missing > 1 ? 's' : ''} incomplete.</strong> The parser couldn't read a type or colour from the name — set them below, or add a match word to the dictionary.</div>` : '',
    dupCount ? `<div class="note red" style="margin-bottom:8px"><strong>${dupCount} duplicate code${dupCount > 1 ? 's' : ''}.</strong> Two products resolved identically. Either they're the same garment listed twice, or one needs its own serial.</div>` : '',
    twins.length ? `<div class="note" style="margin-bottom:8px"><strong>${twins.length} garment${twins.length > 1 ? 's appear' : ' appears'} under more than one industry.</strong> ${twins.slice(0, 4).map(t => `<span class="mono">${esc(t.k.replace(/\|/g, '-'))}</span>`).join(', ')}${twins.length > 4 ? '…' : ''} — if these are physically the same piece, move one to <span class="mono">GEN</span> and add the others under Also sold to. <button class="btn-secondary btn-sm" id="mergeTwins" style="margin-left:6px">Merge to GEN</button></div>` : ''
  ].join('');

  const typeOpts = c => '<option value="">— set —</option>' + S.sku.types
    .map(t => `<option value="${t.code}" ${c === t.code ? 'selected' : ''}>${esc(t.label)}</option>`).join('');
  const colOpts = c => '<option value="">— set —</option>' + S.sku.colours
    .map(t => `<option value="${t.code}" ${c === t.code ? 'selected' : ''}>${esc(t.label)}</option>`).join('');
  const fitOpts = c => S.sku.fits
    .map(t => `<option value="${t.code}" ${c === t.code ? 'selected' : ''}>${esc(t.label)}</option>`).join('');

  $('skuRows').innerHTML = rows.map((r, i) => {
    const col = S.sku.colours.find(c => c.code === r.colour);
    const bad = !r.type || !r.colour || dupes[r.code] > 1;
    const also = r.also || [];
    return `<tr${bad ? ' class="clash"' : ''}>
      <td class="sku">${esc(r.code)}</td>
      <td>${esc(r.name)}</td>
      <td><select data-srow="${i}" data-sf="type">${typeOpts(r.type)}</select></td>
      <td><select data-srow="${i}" data-sf="fit">${fitOpts(r.fit)}</select></td>
      <td><div class="row" style="gap:6px;flex-wrap:nowrap">
        <span class="swatch" style="background:${col ? col.hex : 'transparent'}"></span>
        <select data-srow="${i}" data-sf="colour">${colOpts(r.colour)}</select>
      </div></td>
      <td><details class="also"><summary>${also.length ? also.join(', ') : '— none —'}</summary>
        <div class="also-list">${S.sku.industries.filter(x => x.code !== r.ind && x.code !== 'GEN')
          .map(x => `<label><input type="checkbox" data-also="${i}" value="${x.code}" ${also.includes(x.code) ? 'checked' : ''}> ${esc(x.label)}</label>`).join('')}</div>
      </details></td>
    </tr>`;
  }).join('');

  const mt = $('mergeTwins');
  if (mt) mt.onclick = async () => {
    for (const t of twins) {
      const keep = t.ix[0];
      const others = t.ix.slice(1);
      const inds = t.ix.map(i => rows[i].ind);
      rows[keep].ind = 'GEN';
      rows[keep].also = [...new Set([...(rows[keep].also || []), ...inds])];
      rows[keep].code = buildCode(rows[keep]);
      others.sort((a, b) => b - a).forEach(i => rows.splice(i, 1));
    }
    await persist(); renderSkuRows();
    toast(`${twins.length} merged to GEN`);
  };
}

function generateSkus() {
  const ind = $('skuIndustry').value;
  const industry = S.sku.industries.find(i => i.code === ind);
  if (!industry) return toast('Pick an industry first');
  const lines = $('skuInput').value.split('\n').map(s => s.trim()).filter(Boolean);
  if (!lines.length) return toast('Paste some product names first');

  if ($('skuSerialMode').value === 'restart') {
    S.sku.rows = S.sku.rows.filter(r => r.ind !== ind);
  }

  const counters = {};
  const defFit = $('skuFit').value;
  for (const name of lines) {
    const t = detect(name, S.sku.types, false);
    const c = detect(name, S.sku.colours, true);
    const type = t ? t.code : '';
    const key = `${industry.group}-${ind}-${type}`;
    if (counters[key] === undefined) counters[key] = nextSerial(industry.group, ind, type) - 1;
    counters[key]++;
    const r = { name, ind, type, colour: c ? c.code : '', fit: defFit, serial: counters[key], also: [] };
    r.code = buildCode(r);
    S.sku.rows.push(r);
  }
  $('skuInput').value = '';
  persist(); renderSkuRows();
  toast(`${lines.length} codes generated`);
}

