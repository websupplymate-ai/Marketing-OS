<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SupplyMate Catalogue Studio V1</title>
<style>
/* ─────────────────────────────────────────────
   SUPPLYMATE CATALOGUE STUDIO V1 — Marketing OS Design System
   Green accent · Inter · IBM Plex Mono · light/dark
───────────────────────────────────────────── */
@import url('https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap');

:root {
  --green:      #059669; --green-d: #047857; --green-tint: #ECFDF5; --green-mid: #A7F3D0;
  --blue:       #2563EB; --blue-tint: #EFF6FF; --blue-mid: #BFDBFE;
  --amber:      #D97706; --amber-tint: #FFFBEB; --amber-mid: #FDE68A;
  --red:        #DC2626; --red-tint: #FEF2F2; --red-mid: #FECACA;
  --purple:     #7C3AED; --purple-tint: #F5F3FF; --purple-mid: #DDD6FE;
  --slate:      #64748B;
  --bg:         #FAFAFA; --bg-elevated:#FFFFFF; --bg-sunken:  #F1F5F9;
  --border:     #E2E8F0; --border-mid: #CBD5E1;
  --text:       #0F172A; --text-2: #334155; --muted: #64748B; --muted-2: #94A3B8;
  --radius: 8px; --radius-lg: 12px; --radius-sm: 5px;
  --shadow-sm: 0 1px 3px rgba(0,0,0,.07), 0 1px 2px rgba(0,0,0,.04);
  --shadow: 0 4px 16px rgba(0,0,0,.08), 0 1px 4px rgba(0,0,0,.04);
  --shadow-lg: 0 12px 40px rgba(0,0,0,.12), 0 4px 12px rgba(0,0,0,.06);
  --font: 'Inter', system-ui, sans-serif;
  --mono: 'IBM Plex Mono', monospace;
  --sidebar-w: 224px; --topbar-h: 52px;
}
html[data-theme="dark"] {
  --green: #10B981; --green-d: #059669; --green-tint: #064E3B; --green-mid: #065F46;
  --blue: #3B82F6; --blue-tint: #1E293B; --blue-mid: #1D4ED8;
  --amber: #F59E0B; --amber-tint: #451A03; --amber-mid: #78350F;
  --red: #EF4444; --red-tint: #450A0A; --red-mid: #7F1D1D;
  --purple: #A78BFA; --purple-tint: #2E1065; --purple-mid: #4C1D95;
  --bg: #0D1117; --bg-elevated: #161B22; --bg-sunken: #0A0D13;
  --border: #21262D; --border-mid: #30363D;
  --text: #E6EDF3; --text-2: #C9D1D9; --muted: #8B949E; --muted-2: #6E7681;
  --shadow-sm: 0 1px 3px rgba(0,0,0,.3); --shadow: 0 4px 16px rgba(0,0,0,.4);
  --shadow-lg: 0 12px 40px rgba(0,0,0,.5);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { height: 100%; }
body { background: var(--bg); color: var(--text); font-family: var(--font); font-size: 13px; line-height: 1.5; height: 100%; overflow: hidden; -webkit-font-smoothing: antialiased; }
.mono { font-family: var(--mono); }
a { color: var(--green); text-decoration: none; } a:hover { text-decoration: underline; }
::selection { background: var(--green-tint); color: var(--green); }
::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border-mid); border-radius: 10px; }
::-webkit-scrollbar-thumb:hover { background: var(--muted-2); }
button { font-family: var(--font); }

.topbar { height: var(--topbar-h); background: var(--bg-elevated); border-bottom: 1px solid var(--border); display: flex; align-items: center; padding: 0 16px; gap: 12px; position: fixed; top: 0; left: 0; right: 0; z-index: 100; box-shadow: var(--shadow-sm); }
.tb-wordmark { font-size: 13px; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 7px; user-select: none; white-space: nowrap; }
.tb-wordmark-icon { width: 26px; height: 26px; background: var(--green); border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; color: #fff; letter-spacing: -.5px; flex-shrink: 0; }
.tb-divider { width: 1px; height: 20px; background: var(--border); flex-shrink: 0; }
.tb-breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; }
.tb-breadcrumb strong { color: var(--text); font-weight: 600; }
.tb-right { margin-left: auto; display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.tb-chip { padding: 3px 9px; border-radius: 20px; font-size: 11px; font-weight: 500; border: 1px solid var(--border); color: var(--muted); background: var(--bg); white-space: nowrap; }
.tb-chip.live { background: var(--green-tint); color: var(--green); border-color: var(--green-mid); }
.tb-chip.warn { background: var(--amber-tint); color: var(--amber); border-color: var(--amber-mid); font-family: var(--mono); }
.icon-btn { width: 32px; height: 32px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg-elevated); display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 14px; color: var(--muted); transition: border-color .15s, color .15s; flex-shrink: 0; }
.icon-btn:hover { border-color: var(--green); color: var(--green); }

.app-shell { display: flex; height: calc(100vh - var(--topbar-h)); margin-top: var(--topbar-h); }
.main { flex: 1; overflow-y: auto; padding: 20px 24px 60px; }
.page { display: none; max-width: 1280px; margin: 0 auto; }
.page.active { display: block; }

.sidebar { width: var(--sidebar-w); flex-shrink: 0; background: var(--bg-elevated); border-right: 1px solid var(--border); display: flex; flex-direction: column; overflow-y: auto; padding: 10px 0; }
.sb-item { display: flex; align-items: center; gap: 10px; padding: 8px 16px; cursor: pointer; user-select: none; color: var(--text-2); font-size: 13px; font-weight: 500; border-left: 3px solid transparent; transition: background .12s; }
.sb-item:hover { background: var(--bg-sunken); }
.sb-item.active { background: var(--green-tint); color: var(--green); border-left-color: var(--green); font-weight: 600; }
.sb-item .sb-num { font-family: var(--mono); font-size: 10px; color: var(--muted-2); width: 14px; }
.sb-item.active .sb-num { color: var(--green); }
.sb-item .sb-icon { width: 18px; text-align: center; font-size: 14px; }
.sb-count { margin-left: auto; font-family: var(--mono); font-size: 10px; color: var(--muted-2); }
.sb-item.active .sb-count { color: var(--green); }
.sb-footer { margin-top: auto; padding: 12px 16px; font-size: 10px; color: var(--muted-2); border-top: 1px solid var(--border); line-height: 1.7; }

.card { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 16px; margin-bottom: 14px; box-shadow: var(--shadow-sm); }
.card-title { font-size: 13.5px; font-weight: 600; color: var(--text); margin-bottom: 4px; }
.card-sub { font-size: 12px; color: var(--muted); margin-bottom: 10px; }
.page-h { font-size: 17px; font-weight: 700; margin-bottom: 2px; }
.page-sub { font-size: 12.5px; color: var(--muted); margin-bottom: 16px; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
@media (max-width: 1000px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } }

.btn { display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; border-radius: var(--radius-sm); border: 1px solid var(--green); background: var(--green); color: #fff; font-size: 12.5px; font-weight: 600; cursor: pointer; transition: background .15s; }
.btn:hover { background: var(--green-d); }
.btn:disabled { opacity: .55; cursor: not-allowed; }
.btn-secondary { display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; border-radius: var(--radius-sm); border: 1px solid var(--border-mid); background: var(--bg-elevated); color: var(--text-2); font-size: 12.5px; font-weight: 500; cursor: pointer; transition: border-color .15s, color .15s; }
.btn-secondary:hover { border-color: var(--green); color: var(--green); }
.btn-secondary:disabled { opacity: .55; cursor: not-allowed; }
.btn-danger { display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; border-radius: var(--radius-sm); border: 1px solid var(--red-mid); background: var(--red-tint); color: var(--red); font-size: 12.5px; font-weight: 500; cursor: pointer; }
.btn-sm { padding: 4px 10px; font-size: 11.5px; }

.input, .select, .textarea { width: 100%; padding: 7px 10px; border-radius: var(--radius-sm); border: 1px solid var(--border-mid); background: var(--bg-elevated); color: var(--text); font-size: 12.5px; font-family: var(--font); outline: none; transition: border-color .15s; }
.input:focus, .select:focus, .textarea:focus { border-color: var(--green); }
.textarea { min-height: 90px; resize: vertical; line-height: 1.55; }
.field { margin-bottom: 12px; }
.field label { display: block; font-size: 11px; font-weight: 600; color: var(--muted); margin-bottom: 4px; text-transform: uppercase; letter-spacing: .04em; }
.row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }

.badge { display: inline-flex; align-items: center; padding: 2px 8px; border-radius: 20px; font-size: 10.5px; font-weight: 600; white-space: nowrap; }
.badge.green { background: var(--green-tint); color: var(--green); border: 1px solid var(--green-mid); }
.badge.gray { background: var(--bg-sunken); color: var(--muted); border: 1px solid var(--border); }
.badge.red { background: var(--red-tint); color: var(--red); border: 1px solid var(--red-mid); }
.badge.amber { background: var(--amber-tint); color: var(--amber); border: 1px solid var(--amber-mid); }
.badge.blue { background: var(--blue-tint); color: var(--blue); border: 1px solid var(--blue-mid); }
.badge.purple { background: var(--purple-tint); color: var(--purple); border: 1px solid var(--purple-mid); }

.kpi { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 14px 16px; }
.kpi .k-label { font-size: 10.5px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
.kpi .k-value { font-size: 24px; font-weight: 700; font-family: var(--mono); margin-top: 2px; }
.kpi .k-note { font-size: 11px; color: var(--muted-2); margin-top: 2px; }
.kpi.accent .k-value { color: var(--green); }

/* ── Dropzone ── */
.dropzone { border: 2px dashed var(--border-mid); border-radius: var(--radius-lg); padding: 32px 20px; text-align: center; cursor: pointer; transition: border-color .15s, background .15s; background: var(--bg-sunken); }
.dropzone:hover, .dropzone.over { border-color: var(--green); background: var(--green-tint); }
.dz-icon { font-size: 26px; margin-bottom: 6px; }
.dz-title { font-size: 13px; font-weight: 600; }
.dz-sub { font-size: 11.5px; color: var(--muted); margin-top: 2px; }

/* ── Asset tiles (faces / backdrops) ── */
.tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 10px; }
.tile { border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: var(--bg-sunken); position: relative; }
.tile.sel { border-color: var(--green); box-shadow: 0 0 0 2px var(--green-mid); }
.tile img { width: 100%; height: 110px; object-fit: cover; display: block; }
.tile-meta { padding: 6px 8px; font-size: 11px; }
.tile-name { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tile-note { color: var(--muted); font-size: 10px; }
.tile-x { position: absolute; top: 4px; right: 4px; width: 20px; height: 20px; border-radius: 4px; background: rgba(0,0,0,.6); color: #fff; border: none; cursor: pointer; font-size: 12px; line-height: 1; display: flex; align-items: center; justify-content: center; }

/* ── Cast ── */
.cast { display: grid; grid-template-columns: repeat(auto-fill, minmax(158px, 1fr)); gap: 10px; }
.cast-card { border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: var(--bg-elevated); position: relative; box-shadow: var(--shadow-sm); }
.cast-card img { width: 100%; height: 132px; object-fit: cover; object-position: center 22%; display: block; background: var(--bg-sunken); }
.cast-body { padding: 8px; display: grid; gap: 5px; }
.cast-body .input, .cast-body .select { padding: 4px 6px; font-size: 11px; }
.cast-uses { position: absolute; top: 5px; left: 5px; background: rgba(0,0,0,.68); color: #fff; font-size: 9.5px; font-weight: 600; padding: 2px 7px; border-radius: 10px; font-family: var(--mono); }
.gen-row { display: grid; grid-template-columns: 1fr 90px 1.3fr auto; gap: 8px; align-items: end; }
@media (max-width: 760px) { .gen-row { grid-template-columns: 1fr 1fr; } }

/* ── Subtabs ── */
.subtabs { display: flex; gap: 2px; border-bottom: 1px solid var(--border); margin-bottom: 18px; overflow-x: auto; }
.subtab { padding: 8px 14px; font-size: 12.5px; font-weight: 500; color: var(--muted); cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; white-space: nowrap; user-select: none; }
.subtab:hover { color: var(--text); }
.subtab.active { color: var(--green); border-bottom-color: var(--green); font-weight: 600; }
.subview { display: none; } .subview.active { display: block; }

/* ── Code dictionaries ── */
.dict { width: 100%; border-collapse: collapse; font-size: 12px; }
.dict th { text-align: left; padding: 6px 8px; font-size: 10px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; border-bottom: 1px solid var(--border-mid); background: var(--bg-sunken); }
.dict td { padding: 3px 4px; border-bottom: 1px solid var(--border); }
.dict input, .dict select { width: 100%; padding: 4px 6px; font-size: 11.5px; border: 1px solid transparent; background: transparent; color: var(--text); border-radius: 3px; font-family: var(--font); outline: none; }
.dict input:focus, .dict select:focus { border-color: var(--green); background: var(--bg-elevated); }
.dict input.code { font-family: var(--mono); font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
.dict .x { width: 26px; text-align: center; }
.dict .x button { background: none; border: none; color: var(--muted-2); cursor: pointer; font-size: 13px; padding: 2px 5px; }
.dict .x button:hover { color: var(--red); }
.dict-wrap { max-height: 300px; overflow: auto; border: 1px solid var(--border); border-radius: var(--radius); }
.swatch { width: 22px; height: 22px; border-radius: 4px; border: 1px solid var(--border-mid); display: inline-block; vertical-align: middle; flex-shrink: 0; }
.clash { background: var(--red-tint); }

/* ── Generated codes ── */
.gen-tbl { width: 100%; border-collapse: collapse; font-size: 12px; }
.gen-tbl th { text-align: left; padding: 7px 9px; font-size: 10px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; border-bottom: 1px solid var(--border-mid); background: var(--bg-sunken); position: sticky; top: 0; z-index: 2; }
.gen-tbl td { padding: 5px 9px; border-bottom: 1px solid var(--border); vertical-align: middle; }
.gen-tbl tr:hover td { background: var(--bg-sunken); }
.gen-tbl .sku { font-family: var(--mono); font-size: 12px; font-weight: 600; letter-spacing: .04em; white-space: nowrap; }
.gen-tbl select { padding: 3px 5px; font-size: 11px; border: 1px solid var(--border); border-radius: 3px; background: var(--bg-elevated); color: var(--text); font-family: var(--font); max-width: 130px; }
.gen-wrap { max-height: 480px; overflow: auto; border: 1px solid var(--border); border-radius: var(--radius); }
.seg { color: var(--muted-2); }
.also { position: relative; }
.also summary { cursor: pointer; font-size: 11px; color: var(--muted); list-style: none; padding: 3px 6px; border: 1px solid var(--border); border-radius: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 120px; }
.also summary::-webkit-details-marker { display: none; }
.also[open] summary { border-color: var(--green); color: var(--green); }
.also-list { position: absolute; z-index: 20; right: 0; margin-top: 4px; background: var(--bg-elevated); border: 1px solid var(--border-mid); border-radius: var(--radius); box-shadow: var(--shadow-lg); padding: 8px; min-width: 190px; }
.also-list label { display: flex; align-items: center; gap: 7px; font-size: 11.5px; padding: 3px 2px; cursor: pointer; white-space: nowrap; }
.also-list input { accent-color: var(--green); }

/* ── Queue ── */
.qrow { display: grid; grid-template-columns: 56px 1fr 130px 120px 110px 90px; gap: 10px; align-items: center; padding: 8px 10px; border-bottom: 1px solid var(--border); font-size: 12px; }
.qrow:hover { background: var(--bg-sunken); }
.qhead { font-size: 10.5px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; background: var(--bg-sunken); border-bottom: 1px solid var(--border-mid); }
.qthumb { width: 46px; height: 46px; object-fit: cover; border-radius: var(--radius-sm); border: 1px solid var(--border); display: block; }
.qname { font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.qsub { font-size: 10.5px; color: var(--muted-2); font-family: var(--mono); }
.qwrap { border: 1px solid var(--border); border-radius: var(--radius); overflow: auto; max-height: 520px; background: var(--bg-elevated); }
@media (max-width: 900px) { .qrow { grid-template-columns: 46px 1fr 100px; } .qrow > :nth-child(n+4) { display: none; } }

/* ── Review ── */
.rgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px; }
.rcard { border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-elevated); box-shadow: var(--shadow-sm); }
.rcard.approved { border-color: var(--green); }
.rcard.rejected { opacity: .5; }
.ba { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--border); }
.ba figure { background: var(--bg-sunken); position: relative; }
.ba img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
.ba figcaption { position: absolute; top: 4px; left: 4px; font-size: 9px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; background: rgba(0,0,0,.65); color: #fff; padding: 2px 5px; border-radius: 3px; }
.rmeta { padding: 8px 10px; }
.rname { font-size: 12px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ractions { display: flex; gap: 5px; padding: 0 10px 10px; }

/* ── Misc ── */
.note { border-left: 3px solid var(--amber); background: var(--amber-tint); color: var(--text-2); padding: 9px 12px; border-radius: 0 var(--radius-sm) var(--radius-sm) 0; font-size: 12px; margin-bottom: 12px; }
.note.green { border-left-color: var(--green); background: var(--green-tint); }
.note.red { border-left-color: var(--red); background: var(--red-tint); }
.note strong { font-weight: 600; }
.empty { text-align: center; padding: 40px 20px; color: var(--muted); }
.empty-icon { font-size: 30px; margin-bottom: 8px; opacity: .5; }
.empty-title { font-size: 13px; font-weight: 600; color: var(--text-2); margin-bottom: 3px; }
pre.code { background: var(--bg-sunken); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px; font-family: var(--mono); font-size: 11px; line-height: 1.6; overflow-x: auto; white-space: pre; color: var(--text-2); }
.bar { height: 5px; background: var(--bg-sunken); border-radius: 10px; overflow: hidden; margin-top: 6px; }
.bar > div { height: 100%; background: var(--green); width: 0%; transition: width .3s; }
.toast { position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%); background: var(--text); color: var(--bg); padding: 9px 16px; border-radius: 20px; font-size: 12.5px; font-weight: 500; z-index: 500; box-shadow: var(--shadow-lg); opacity: 0; pointer-events: none; transition: opacity .25s, transform .25s; }
.toast.show { opacity: 1; transform: translateX(-50%) translateY(-4px); }
.slider { width: 100%; accent-color: var(--green); }
.chk { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; cursor: pointer; user-select: none; }
.chk input { accent-color: var(--green); }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>
</head>
<body>

<div class="topbar">
  <div class="tb-wordmark"><span class="tb-wordmark-icon">SM</span> Catalogue Studio</div>
  <div class="tb-divider"></div>
  <div class="tb-breadcrumb">Marketing OS <span>/</span> <strong id="crumb">Setup</strong></div>
  <div class="tb-right">
    <span class="tb-chip" id="chipStore">0 in batch</span>
    <span class="tb-chip warn" id="chipCost">₹0 est.</span>
    <button class="icon-btn" id="themeBtn" title="Toggle theme">◐</button>
  </div>
</div>

<div class="app-shell">
  <nav class="sidebar" id="sidebar">
    <div class="sb-item active" data-page="setup"><span class="sb-num">1</span><span class="sb-icon">⚙</span>Setup</div>
    <div class="sb-item" data-page="intake"><span class="sb-num">2</span><span class="sb-icon">⬆</span>Intake<span class="sb-count" id="cIntake">0</span></div>
    <div class="sb-item" data-page="process"><span class="sb-num">3</span><span class="sb-icon">▶</span>Process<span class="sb-count" id="cProcess">0</span></div>
    <div class="sb-item" data-page="review"><span class="sb-num">4</span><span class="sb-icon">◍</span>Review<span class="sb-count" id="cReview">0</span></div>
    <div class="sb-item" data-page="export"><span class="sb-num">5</span><span class="sb-icon">⬇</span>Export<span class="sb-count" id="cExport">0</span></div>
    <div class="sb-footer">
      Catalogue Studio V1<br>
      Your own photography only.<br>
      <span class="mono" id="storeState">memory</span>
    </div>
  </nav>

  <main class="main">

    <!-- ══════════ 1. SETUP ══════════ -->
    <section class="page active" id="page-setup">
      <div class="page-h">Setup</div>
      <div class="page-sub">Define your model identities, backdrops, and processing endpoint once. Everything after this is batch work.</div>

      <div class="subtabs">
        <div class="subtab active" data-sv="studio">Studio</div>
        <div class="subtab" data-sv="sku">SKU codes</div>
        <div class="subtab" data-sv="master">Product master</div>
      </div>

      <div class="subview active" id="sv-studio">
      <div class="note"><strong>Source rule:</strong> only load photographs SupplyMate shot or commissioned. This tool has no capability to strip watermarks and will not process third-party catalogue images.</div>

      <div class="card">
        <div class="card-title">Processing endpoint</div>
        <div class="card-sub">Your Cloudflare Worker proxy. The API key lives as a Worker secret, never in this file.</div>
        <div class="grid-2">
          <div class="field">
            <label>Worker endpoint URL</label>
            <input class="input" id="cfgEndpoint" placeholder="https://marketing-os.web-supplymate.workers.dev/api/image">
          </div>
          <div class="field">
            <label>Provider</label>
            <select class="select" id="cfgProvider">
              <option value="replicate">Replicate — face swap (recommended)</option>
              <option value="fal">fal.ai — face swap</option>
              <option value="custom">Custom endpoint</option>
            </select>
          </div>
        </div>
        <div class="row">
          <button class="btn-secondary btn-sm" id="testEndpoint">Test connection</button>
          <span id="endpointState" class="badge gray">Not tested</span>
        </div>
      </div>

      <div class="card">
        <div class="row" style="justify-content:space-between;margin-bottom:4px">
          <div class="card-title">Cast</div>
          <div class="row">
            <span class="badge gray" id="castCount">0 in the cast</span>
            <select class="select" id="castFilter" style="width:auto;padding:4px 8px;font-size:11.5px"></select>
          </div>
        </div>
        <div class="card-sub">Your permanent roster of synthetic models. Name each one, assign an industry, and the same face carries across every image in that industry — so the catalogue reads as one shoot rather than 140 strangers.</div>
        <div class="note green" style="margin-bottom:12px">Synthetic faces only. Never a photograph of a real person who hasn't agreed to it — that's the one line that turns this from your own work into someone else's likeness.</div>

        <div class="gen-row" style="margin-bottom:12px">
          <div class="field" style="margin:0">
            <label>Gender</label>
            <select class="select" id="genGender"><option>man</option><option>woman</option></select>
          </div>
          <div class="field" style="margin:0">
            <label>Age</label>
            <input class="input" id="genAge" type="number" value="30" min="18" max="70">
          </div>
          <div class="field" style="margin:0">
            <label>Industry</label>
            <select class="select" id="genVertical"></select>
          </div>
          <button class="btn" id="genFace">Generate</button>
        </div>

        <div class="dropzone" id="dzFaces" style="padding:16px">
          <div class="dz-icon">☺</div>
          <div class="dz-title">Or upload a reference face</div>
          <div class="dz-sub">Front-facing, evenly lit, one face per image</div>
        </div>

        <div class="cast" id="faceTiles" style="margin-top:12px"></div>
      </div>

      <div class="card">
        <div class="row" style="justify-content:space-between;margin-bottom:4px">
          <div class="card-title">Backdrops</div>
          <div class="row">
            <span class="badge gray" id="bdCount">0 loaded</span>
            <select class="select" id="bdFilter" style="width:auto;padding:4px 8px;font-size:11.5px"></select>
          </div>
        </div>
        <div class="card-sub">Grouped by industry. Load as many scenes per industry as you like — intake lets you pick which of them a batch draws from.</div>
        <div class="dropzone" id="dzBackdrops" style="padding:20px">
          <div class="dz-icon">▤</div>
          <div class="dz-title">Add backdrops</div>
          <div class="dz-sub">Any resolution — they get scaled to cover the output frame</div>
        </div>
        <div id="bdTiles" style="margin-top:12px"></div>
      </div>

      <div class="grid-2">
        <div class="card">
          <div class="card-title">Output format</div>
          <div class="card-sub">Applied to every exported image.</div>
          <div class="field">
            <label>Aspect ratio</label>
            <select class="select" id="cfgAspect">
              <option value="1:1">1:1 square — Shopify main</option>
              <option value="4:5">4:5 portrait — Meta feed</option>
              <option value="3:4">3:4 portrait — catalogue</option>
              <option value="9:16">9:16 — Reels / Stories</option>
            </select>
          </div>
          <div class="field">
            <label>Longest edge (px)</label>
            <input class="input" id="cfgSize" type="number" value="2048" min="512" max="4096" step="128">
          </div>
          <div class="field">
            <label>Format</label>
            <select class="select" id="cfgFormat">
              <option value="image/jpeg">JPEG — smaller, faster storefront</option>
              <option value="image/png">PNG — larger, lossless</option>
            </select>
          </div>
        </div>
        <div class="card">
          <div class="card-title">Watermark</div>
          <div class="card-sub">Your mark on your images. Optional but worth doing before these go public.</div>
          <div class="dropzone" id="dzLogo" style="padding:16px">
            <div class="dz-icon">◈</div>
            <div class="dz-title">Add SupplyMate logo</div>
            <div class="dz-sub">Transparent PNG works best</div>
          </div>
          <div id="logoPreview" style="margin-top:10px"></div>
          <div class="field" style="margin-top:10px">
            <label>Position</label>
            <select class="select" id="cfgWmPos">
              <option value="br">Bottom right</option>
              <option value="bl">Bottom left</option>
              <option value="tr">Top right</option>
              <option value="tl">Top left</option>
            </select>
          </div>
          <div class="field">
            <label>Opacity — <span class="mono" id="wmOpVal">55%</span></label>
            <input class="slider" id="cfgWmOp" type="range" min="10" max="100" value="55">
          </div>
          <div class="field">
            <label>Size — <span class="mono" id="wmSzVal">14%</span> of width</label>
            <input class="slider" id="cfgWmSz" type="range" min="5" max="35" value="14">
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Worker proxy code</div>
        <div class="card-sub">Deploy this alongside your existing Worker. Set the key with <span class="mono">wrangler secret put REPLICATE_API_TOKEN</span>.</div>
        <button class="btn-secondary btn-sm" id="copyWorker" style="margin-bottom:10px">Copy Worker code</button>
        <pre class="code" id="workerCode"></pre>
      </div>
      </div><!-- /sv-studio -->

      <div class="subview" id="sv-sku">
        <div class="card">
          <div class="card-title">Code shape</div>
          <div class="card-sub">Fixed at 23 characters. Letters and digits never share a segment, so nobody has to decide between O and 0.</div>
          <pre class="code" style="font-size:12px;line-height:1.8">WW - SEC - SHI - 0042 - FIT - NVY
│    │     │     │      │     └─ Base colour   3 letters
│    │     │     │      └─────── Fit           3 letters
│    │     │     └────────────── Serial        4 digits, padded
│    │     └──────────────────── Product type  3 letters
│    └────────────────────────── Industry      3 letters
└─────────────────────────────── Group         2 letters</pre>
          <div class="note green" style="margin-top:12px;margin-bottom:0"><strong>Group, industry, type and serial identify the design. Fit and colour are its variations,</strong> so they sit together at the tail and colour ends the code. Serial runs within group + industry + type, so security shirts number 0001 upward rather than 0731 upward.</div>
        </div>

        <div class="card">
          <div class="row" style="justify-content:space-between;margin-bottom:8px">
            <div><div class="card-title">Fits</div><div class="card-sub" style="margin:0">Cut variations of the same design.</div></div>
            <button class="btn-secondary btn-sm" data-addrow="fits">Add</button>
          </div>
          <div class="dict-wrap" style="max-height:150px">
            <table class="dict"><thead><tr><th style="width:74px">Code</th><th>Label</th><th class="x"></th></tr></thead>
            <tbody id="dictFits"></tbody></table>
          </div>
        </div>

        <div class="grid-2">
          <div class="card">
            <div class="row" style="justify-content:space-between;margin-bottom:8px">
              <div><div class="card-title">Industries</div><div class="card-sub" style="margin:0">Locked list. Never free-text.</div></div>
              <button class="btn-secondary btn-sm" data-addrow="industries">Add</button>
            </div>
            <div class="dict-wrap">
              <table class="dict"><thead><tr><th style="width:74px">Code</th><th>Label</th><th style="width:70px">Group</th><th class="x"></th></tr></thead>
              <tbody id="dictIndustries"></tbody></table>
            </div>
          </div>

          <div class="card">
            <div class="row" style="justify-content:space-between;margin-bottom:8px">
              <div><div class="card-title">Colours</div><div class="card-sub" style="margin:0">The swatch is what the floor actually matches on.</div></div>
              <button class="btn-secondary btn-sm" data-addrow="colours">Add</button>
            </div>
            <div class="dict-wrap">
              <table class="dict"><thead><tr><th style="width:40px"></th><th style="width:74px">Code</th><th>Label</th><th class="x"></th></tr></thead>
              <tbody id="dictColours"></tbody></table>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="row" style="justify-content:space-between;margin-bottom:8px">
            <div><div class="card-title">Product types</div><div class="card-sub" style="margin:0">Match words are what the parser looks for in a product name — comma separated, longest wins.</div></div>
            <button class="btn-secondary btn-sm" data-addrow="types">Add</button>
          </div>
          <div class="dict-wrap">
            <table class="dict"><thead><tr><th style="width:74px">Code</th><th style="width:180px">Label</th><th>Match words</th><th class="x"></th></tr></thead>
            <tbody id="dictTypes"></tbody></table>
          </div>
          <div id="clashWarn" style="margin-top:10px"></div>
        </div>

        <div class="card">
          <div class="card-title">Generate</div>
          <div class="card-sub">Paste product names, one per line. The parser reads type and colour from each name; anything it can't read is flagged for you to set by hand.</div>
          <div class="note" style="margin-bottom:10px"><strong>Colour means the base colour of the garment.</strong> Where a name lists several — "Black &amp; Yellow Lining Vest Coat" — the parser takes the first as the body and ignores contrast trims.</div>
          <div class="row" style="margin-bottom:10px">
            <div class="field" style="margin:0;min-width:200px">
              <label>Industry for this batch</label>
              <select class="select" id="skuIndustry"></select>
            </div>
            <div class="field" style="margin:0;min-width:130px">
              <label>Default fit</label>
              <select class="select" id="skuFit"></select>
            </div>
            <div class="field" style="margin:0;min-width:150px">
              <label>Continue serials from</label>
              <select class="select" id="skuSerialMode">
                <option value="continue">Existing codes</option>
                <option value="restart">Restart at 0001</option>
              </select>
            </div>
          </div>
          <textarea class="textarea" id="skuInput" placeholder="White Security Guard Shirt For Men&#10;Black Security Guard Shirt For Men&#10;Male Navy Blue Security Guard Trouser With Three Loops"></textarea>
          <div class="row" style="margin-top:10px">
            <button class="btn" id="skuGenerate">Generate codes</button>
            <button class="btn-secondary btn-sm" id="skuClear">Clear all</button>
          </div>
        </div>

        <div class="card" id="skuResultCard" style="display:none">
          <div class="row" style="justify-content:space-between;margin-bottom:10px">
            <div><div class="card-title">Generated</div><div class="card-sub" style="margin:0" id="skuSummary"></div></div>
            <div class="row">
              <button class="btn-secondary btn-sm" id="skuFactory">Factory sheet</button>
              <button class="btn-secondary btn-sm" id="skuCsv">Export CSV</button>
            </div>
          </div>
          <div id="skuFlags"></div>
          <div class="gen-wrap">
            <table class="gen-tbl">
              <thead><tr><th style="width:215px">Code</th><th>Product name</th><th style="width:130px">Type</th><th style="width:105px">Fit</th><th style="width:140px">Base colour</th><th style="width:130px">Also sold to</th></tr></thead>
              <tbody id="skuRows"></tbody>
            </table>
          </div>
        </div>
      </div><!-- /sv-sku -->

      <div class="subview" id="sv-master">
        <div class="card">
          <div class="card-title">Google Sheet</div>
          <div class="card-sub">The sheet is the master record; this app is the working surface. Pull reads it in, push writes it back — same Apps Script pattern as Content Studio V8.</div>
          <div class="field">
            <label>Apps Script web app URL</label>
            <input class="input" id="mSheetUrl" placeholder="https://script.google.com/macros/s/…/exec">
          </div>
          <div class="row">
            <button class="btn" id="mPull">Pull from Sheet</button>
            <button class="btn-secondary" id="mPush">Push to Sheet</button>
            <span class="badge gray" id="mState">Not connected</span>
          </div>
          <div class="bar" style="margin-top:10px"><div id="mBar"></div></div>
        </div>

        <div class="card">
          <div class="card-title">Columns</div>
          <div class="card-sub">Tab name: <span class="mono">Product Master</span>. Headers on row 2, data from row 3 — matching your Content Studio sheet.</div>
          <pre class="code">SKU · Product Name · Group · Primary Industry · Also Sold To
Product Type · Fit · Base Colour · Fabric Composition · GSM
Description · Price · MOQ · Image Drive Link · Status · Updated At</pre>
          <div class="note" style="margin-top:10px;margin-bottom:0"><strong>SKU is the key.</strong> Pull matches on it — existing rows update, new ones are added, and nothing in the sheet is deleted by a pull. Push rewrites the tab from what's in the app.</div>
        </div>

        <div class="card" id="mListCard" style="display:none">
          <div class="row" style="justify-content:space-between;margin-bottom:10px">
            <div><div class="card-title">Products</div><div class="card-sub" style="margin:0" id="mCount"></div></div>
            <div class="row">
              <input class="input" id="mSearch" placeholder="Search SKU or name" style="width:220px;padding:5px 9px;font-size:11.5px">
              <button class="btn-secondary btn-sm" id="mCsv">Export CSV</button>
            </div>
          </div>
          <div class="gen-wrap">
            <table class="gen-tbl">
              <thead><tr><th style="width:215px">SKU</th><th>Name</th><th style="width:120px">Fabric</th><th style="width:60px">GSM</th><th style="width:80px">Price</th><th style="width:70px">Image</th></tr></thead>
              <tbody id="mRows"></tbody>
            </table>
          </div>
        </div>

        <div class="card">
          <div class="card-title">Apps Script</div>
          <div class="card-sub">Paste into the sheet's Apps Script editor, deploy as a web app (execute as you, access to anyone), then paste the /exec URL above.</div>
          <button class="btn-secondary btn-sm" id="copyMaster" style="margin-bottom:10px">Copy Apps Script</button>
          <pre class="code" id="masterCode"></pre>
        </div>
      </div><!-- /sv-master -->
    </section>

    <!-- ══════════ 2. INTAKE ══════════ -->
    <section class="page" id="page-intake">
      <div class="page-h">Intake</div>
      <div class="page-sub">Load one vertical at a time — 10 to 15 images per batch keeps the queue reviewable.</div>

      <div class="card">
        <div class="card-title">Batch settings</div>
        <div class="card-sub">The SKU drives everything. Set it from the dropdowns, or type a full code and the dropdowns follow.</div>

        <div class="grid-3" style="margin-bottom:10px">
          <div class="field" style="margin:0">
            <label>Industry</label>
            <select class="select" id="inIndustry"></select>
          </div>
          <div class="field" style="margin:0">
            <label>Product type</label>
            <select class="select" id="inType"></select>
          </div>
          <div class="field" style="margin:0">
            <label>Fit</label>
            <select class="select" id="inFit"></select>
          </div>
        </div>
        <div class="grid-3" style="margin-bottom:10px">
          <div class="field" style="margin:0">
            <label>Base colour</label>
            <select class="select" id="inColour"></select>
          </div>
          <div class="field" style="margin:0">
            <label>Serial starts at</label>
            <input class="input mono" id="inSerial" type="number" value="1" min="1" max="9999">
          </div>
          <div class="field" style="margin:0">
            <label>Identity</label>
            <select class="select" id="inFace"></select>
          </div>
        </div>

        <div class="field">
          <label>SKU — type a full code to set the dropdowns</label>
          <div class="row" style="flex-wrap:nowrap">
            <input class="input mono" id="inSku" style="font-size:15px;font-weight:600;letter-spacing:.08em" placeholder="WW-SEC-SHI-0001-FIT-NVY">
            <span class="badge gray" id="inSkuState">—</span>
          </div>
        </div>

        <div class="field" style="margin-bottom:0">
          <label>Backdrops this batch draws from</label>
          <div id="inBdPool" class="row" style="gap:8px"></div>
          <div class="row" style="margin-top:8px">
            <select class="select" id="inBdMode" style="width:auto;padding:5px 9px;font-size:11.5px">
              <option value="cycle">Rotate through selected</option>
              <option value="random">Pick at random</option>
              <option value="first">Use the first only</option>
            </select>
            <span class="card-sub" style="margin:0">Select several to mix scenes across one batch.</span>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="dropzone" id="dzProducts">
          <div class="dz-icon">⬆</div>
          <div class="dz-title">Drop product photographs here</div>
          <div class="dz-sub">JPG, PNG or WebP · your own shots only · 10–15 at a time</div>
        </div>
      </div>

      <div class="card" id="intakeListCard">
        <div class="row" style="justify-content:space-between;margin-bottom:10px">
          <div>
            <div class="card-title">Batch</div>
            <div class="card-sub" style="margin:0">Every row carries its own SKU. Edit any of them directly.</div>
          </div>
          <div class="row">
            <select class="select" id="bulkFace" style="width:auto;padding:4px 8px;font-size:11.5px">
              <option value="">Set identity for all…</option>
            </select>
            <button class="btn-secondary btn-sm" id="clearBatch">Clear batch</button>
            <button class="btn btn-sm" id="sendToProcess">Send to processing</button>
          </div>
        </div>
        <div class="qwrap">
          <div class="qrow qhead">
            <div></div><div>Product</div><div>SKU</div><div>Identity</div><div>Backdrop</div><div></div>
          </div>
          <div id="intakeList"></div>
        </div>
      </div>
    </section>

    <!-- ══════════ 3. PROCESS ══════════ -->
    <section class="page" id="page-process">
      <div class="page-h">Process</div>
      <div class="page-sub">Face swap, cutout, backdrop, crop, watermark — run as one pass per image.</div>

      <div class="grid-3" style="margin-bottom:14px">
        <div class="kpi"><div class="k-label">Queued</div><div class="k-value" id="kQueued">0</div><div class="k-note">waiting to run</div></div>
        <div class="kpi accent"><div class="k-label">Done</div><div class="k-value" id="kDone">0</div><div class="k-note">ready for review</div></div>
        <div class="kpi"><div class="k-label">Failed</div><div class="k-value" id="kFailed">0</div><div class="k-note">retry individually</div></div>
      </div>

      <div class="card">
        <div class="row" style="justify-content:space-between">
          <div style="flex:1;min-width:220px">
            <div class="card-title">Pipeline</div>
            <div class="card-sub" id="runStatus">Idle</div>
            <div class="bar"><div id="runBar"></div></div>
          </div>
          <div class="row">
            <button class="btn-secondary btn-sm" id="stopRun" disabled>Stop</button>
            <button class="btn" id="startRun">Run batch</button>
          </div>
        </div>
        <div class="row" style="margin-top:14px;gap:18px">
          <label class="chk"><input type="checkbox" id="stepSwap" checked> Face swap</label>
          <label class="chk"><input type="checkbox" id="stepCut" checked> Cut out subject</label>
          <label class="chk"><input type="checkbox" id="stepBd" checked> Place on backdrop</label>
          <label class="chk"><input type="checkbox" id="stepWm"> Apply watermark</label>
        </div>
        <div class="field" style="margin-top:14px;max-width:340px">
          <label>Cutout method</label>
          <select class="select" id="cfgCutout">
            <option value="quick">Quick — plain background, runs locally and free</option>
            <option value="api">AI — any background, costs per image</option>
          </select>
        </div>
        <div class="field" style="max-width:340px" id="tolField">
          <label>Edge tolerance — <span class="mono" id="tolVal">32</span></label>
          <input class="slider" id="cfgTol" type="range" min="5" max="90" value="32">
          <div class="card-sub" style="margin:4px 0 0">Raise it if background remains, lower it if the garment gets eaten.</div>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Queue</div>
        <div class="qwrap">
          <div class="qrow qhead"><div></div><div>Product</div><div>SKU</div><div>Identity</div><div>Status</div><div></div></div>
          <div id="processList"></div>
        </div>
      </div>
    </section>

    <!-- ══════════ 4. REVIEW ══════════ -->
    <section class="page" id="page-review">
      <div class="page-h">Review</div>
      <div class="page-sub">Before and after, side by side. Approve what ships, send the rest back.</div>
      <div class="card">
        <div class="row" style="justify-content:space-between">
          <div class="row">
            <button class="btn-secondary btn-sm" id="approveAll">Approve all</button>
            <button class="btn-secondary btn-sm" id="filterToggle">Show all</button>
          </div>
          <div class="row">
            <span class="badge green" id="rApproved">0 approved</span>
            <span class="badge gray" id="rPending">0 pending</span>
          </div>
        </div>
      </div>
      <div class="rgrid" id="reviewGrid"></div>
    </section>

    <!-- ══════════ 5. EXPORT ══════════ -->
    <section class="page" id="page-export">
      <div class="page-h">Export</div>
      <div class="page-sub">Approved images, renamed to your SKU convention, plus a Shopify product CSV.</div>

      <div class="grid-2">
        <div class="card">
          <div class="card-title">Images</div>
          <div class="card-sub">Downloads one at a time. Your browser may ask to allow multiple files — say yes.</div>
          <div class="row">
            <button class="btn" id="dlImages">Download approved images</button>
            <span class="badge gray" id="dlCount">0 ready</span>
          </div>
          <div class="bar" style="margin-top:10px"><div id="dlBar"></div></div>
        </div>
        <div class="card">
          <div class="card-title">Shopify CSV</div>
          <div class="card-sub">Product rows with handles, SKUs and image alt text. Image Src stays blank until you've uploaded the files — Shopify fills it on match, or paste your CDN paths in.</div>
          <div class="field">
            <label>Vendor</label>
            <input class="input" id="csvVendor" value="SupplyMate">
          </div>
          <div class="field">
            <label>Default price (₹)</label>
            <input class="input" id="csvPrice" type="number" value="0" step="1">
