  const csv = MASTER_COLS.map(q).join(',') + '\n'
    + S.master.map(m => keys.map(k => q(m[k])).join(',')).join('\n');
  download('supplymate_product_master.csv', 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv));
  toast('CSV downloaded');
}

const MASTER_SRC = `/**
 * SUPPLYMATE CATALOGUE STUDIO — PRODUCT MASTER (two-way)
 * -----------------------------------------------------
 * GET  ?action=read   → returns every row of the "Product Master" tab
 * POST {action:'write', products:[…]} → rewrites the tab
 *
 * SETUP
 * 1. Extensions → Apps Script, paste this file
 * 2. Deploy → New deployment → Web app
 *      Execute as: Me · Who has access: Anyone
 * 3. Copy the /exec URL into Catalogue Studio → Setup → Product master
 */

var TAB  = 'Product Master';
var COLS = ['SKU','Product Name','Group','Primary Industry','Also Sold To',
            'Product Type','Fit','Base Colour','Fabric Composition','GSM',
            'Description','Price','MOQ','Image Drive Link','Status','Updated At'];
var KEYS = ['sku','name','group','industry','also','type','fit','colour',
            'fabric','gsm','description','price','moq','image','status','updated'];

function doGet(e) {
  var action = e && e.parameter ? e.parameter.action : '';
  if (action !== 'read') return out({ ok: true, msg: 'Product Master endpoint is live.' });
  try {
    var sh = sheet();
    var last = sh.getLastRow();
    if (last < 3) return out({ ok: true, rows: [] });
    var vals = sh.getRange(3, 1, last - 2, COLS.length).getValues();
    var rows = [];
    for (var i = 0; i < vals.length; i++) {
      if (!vals[i][0]) continue;
      var o = {};
      for (var c = 0; c < KEYS.length; c++) o[KEYS[c]] = String(vals[i][c] == null ? '' : vals[i][c]);
      rows.push(o);
    }
    return out({ ok: true, rows: rows });
  } catch (err) { return out({ ok: false, error: String(err) }); }
}

function doPost(e) {
  try {
    var data = JSON.parse(e.postData.contents);
    if (data.action === 'upload') return handleUpload(data);
    if (data.action !== 'write') return out({ ok: false, error: 'Unknown action' });
    var sh = sheet();
    var rows = (data.products || []).map(function (p) {
      return KEYS.map(function (k) { return p[k] == null ? '' : p[k]; });
    });
    var last = sh.getLastRow();
    if (last > 2) sh.getRange(3, 1, last - 2, COLS.length).clearContent();
    if (rows.length) sh.getRange(3, 1, rows.length, COLS.length).setValues(rows);
    sh.getRange(1, 1).setValue('PRODUCT MASTER  ·  last sync: ' + (data.syncedAt || new Date()));
    return out({ ok: true, written: rows.length });
  } catch (err) { return out({ ok: false, error: String(err) }); }
}

/** Saves a base64 image into Drive, makes it link-viewable, returns the URL. */
function handleUpload(data) {
  var folderName = 'Catalogue Studio Images';
  var it = DriveApp.getFoldersByName(folderName);
  var folder = it.hasNext() ? it.next() : DriveApp.createFolder(folderName);
  var name = data.filename || ('image_' + Date.now());
  // Replace rather than duplicate when the same SKU is re-uploaded.
  var existing = folder.getFilesByName(name);
  while (existing.hasNext()) existing.next().setTrashed(true);
  var blob = Utilities.newBlob(Utilities.base64Decode(data.data), data.mimeType || 'image/jpeg', name);
  var file = folder.createFile(blob);
  file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  return out({ ok: true, url: file.getUrl(), fileId: file.getId() });
}

function sheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(TAB);
  if (!sh) {
    sh = ss.insertSheet(TAB);
    sh.getRange(1, 1).setValue('PRODUCT MASTER');
  }
  sh.getRange(2, 1, 1, COLS.length).setValues([COLS])
    .setFontWeight('bold').setFontColor('#FFFFFF').setBackground('#059669');
  sh.setFrozenRows(2);
  return sh;
}

function out(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}`;


