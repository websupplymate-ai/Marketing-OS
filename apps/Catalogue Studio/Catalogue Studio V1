  $('dictTypes').innerHTML = S.sku.types.map((r, i) => `
    <tr><td><input class="code" maxlength="3" value="${esc(r.code)}" data-d="types" data-i="${i}" data-f="code"></td>
    <td><input value="${esc(r.label)}" data-d="types" data-i="${i}" data-f="label"></td>
