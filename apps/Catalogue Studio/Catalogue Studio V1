/* ═══════════ IMAGE OPS ═══════════ */

/* Flood-fill from the frame edges. Works well on plain-wall phone shots,
   which is what most of the existing library is. */
async function quickCutout(src, tol) {
  const img = await loadImg(src);
  const c = document.createElement('canvas');
  c.width = img.naturalWidth; c.height = img.naturalHeight;
  const ctx = c.getContext('2d', { willReadFrequently: true });
  ctx.drawImage(img, 0, 0);
  const d = ctx.getImageData(0, 0, c.width, c.height), px = d.data, W = c.width, H = c.height;
  const seen = new Uint8Array(W * H), stack = [];
  const seeds = [[0, 0], [W - 1, 0], [0, H - 1], [W - 1, H - 1], [W >> 1, 0], [W >> 1, H - 1], [0, H >> 1], [W - 1, H >> 1]];
  const ref = seeds.map(([x, y]) => { const i = (y * W + x) * 4; return [px[i], px[i + 1], px[i + 2]]; });
  const near = (r, g, b) => ref.some(([R, G, B]) => Math.abs(r - R) + Math.abs(g - G) + Math.abs(b - B) < tol * 3);
  for (const [x, y] of seeds) stack.push(y * W + x);
  while (stack.length) {
    const p = stack.pop();
    if (p < 0 || p >= W * H || seen[p]) continue;
    const i = p * 4;
    if (!near(px[i], px[i + 1], px[i + 2])) continue;
    seen[p] = 1; px[i + 3] = 0;
    const x = p % W;
    if (x > 0) stack.push(p - 1);
    if (x < W - 1) stack.push(p + 1);
    stack.push(p - W, p + W);
  }
  // Soften the cut edge so the composite doesn't look pasted on.
  for (let p = 0; p < W * H; p++) {
    if (px[p * 4 + 3] === 0) continue;
    let open = 0;
    const x = p % W, y = (p / W) | 0;
    for (let dy = -1; dy <= 1; dy++) for (let dx = -1; dx <= 1; dx++) {
      const nx = x + dx, ny = y + dy;
      if (nx < 0 || ny < 0 || nx >= W || ny >= H) continue;
      if (seen[ny * W + nx]) open++;
    }
    if (open > 0) px[p * 4 + 3] = Math.max(0, 255 - open * 42);
  }
  ctx.putImageData(d, 0, 0);
  return c.toDataURL('image/png');
}

/* Compose: backdrop (cover) → subject (contain, bottom-anchored) → watermark */
async function compose(subjectSrc, backdropSrc, opts) {
  const { w, h } = aspectDims(opts.aspect, opts.size);
  const c = document.createElement('canvas');
  c.width = w; c.height = h;
  const ctx = c.getContext('2d');

  if (backdropSrc) {
    const bd = await loadImg(backdropSrc);
    const s = Math.max(w / bd.naturalWidth, h / bd.naturalHeight);
    const dw = bd.naturalWidth * s, dh = bd.naturalHeight * s;
    ctx.drawImage(bd, (w - dw) / 2, (h - dh) / 2, dw, dh);
  } else {
    ctx.fillStyle = '#FFFFFF'; ctx.fillRect(0, 0, w, h);
  }

  const sub = await loadImg(subjectSrc);
  const pad = 0.90;
  const s2 = Math.min(w * pad / sub.naturalWidth, h * pad / sub.naturalHeight);
  const sw = sub.naturalWidth * s2, sh = sub.naturalHeight * s2;
  ctx.drawImage(sub, (w - sw) / 2, h - sh - h * 0.02, sw, sh);

  if (opts.logo) {
    const lg = await loadImg(opts.logo);
    const lw = w * (opts.wmSz / 100), lh = lg.naturalHeight * (lw / lg.naturalWidth);
    const m = w * 0.035;
    const pos = { br: [w - lw - m, h - lh - m], bl: [m, h - lh - m], tr: [w - lw - m, m], tl: [m, m] }[opts.wmPos];
    ctx.globalAlpha = opts.wmOp / 100;
    ctx.drawImage(lg, pos[0], pos[1], lw, lh);
    ctx.globalAlpha = 1;
  }
  return c.toDataURL(opts.format, 0.92);
}

/* Crop-and-fit without a backdrop swap */
async function fitOnly(src, opts) {
  const { w, h } = aspectDims(opts.aspect, opts.size);
  const c = document.createElement('canvas');
  c.width = w; c.height = h;
  const ctx = c.getContext('2d');
  ctx.fillStyle = '#FFFFFF'; ctx.fillRect(0, 0, w, h);
  const img = await loadImg(src);
  const s = Math.max(w / img.naturalWidth, h / img.naturalHeight);
  const dw = img.naturalWidth * s, dh = img.naturalHeight * s;
  ctx.drawImage(img, (w - dw) / 2, (h - dh) / 2, dw, dh);
  if (opts.logo) {
    const lg = await loadImg(opts.logo);
    const lw = w * (opts.wmSz / 100), lh = lg.naturalHeight * (lw / lg.naturalWidth);
    const m = w * 0.035;
    const pos = { br: [w - lw - m, h - lh - m], bl: [m, h - lh - m], tr: [w - lw - m, m], tl: [m, m] }[opts.wmPos];
    ctx.globalAlpha = opts.wmOp / 100;
    ctx.drawImage(lg, pos[0], pos[1], lw, lh);
    ctx.globalAlpha = 1;
  }
  return c.toDataURL(opts.format, 0.92);
}

/* ═══════════ API ═══════════ */
async function callApi(op, payload) {
  if (!S.cfg.endpoint) throw new Error('No endpoint set — add your Worker URL in Setup');
  const r = await fetch(S.cfg.endpoint, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ op, provider: S.cfg.provider, ...payload })
  });
  if (!r.ok) {
    let detail = '';
    try { detail = (await r.json()).error || ''; } catch {}
    throw new Error(`Endpoint returned ${r.status}${detail ? ' — ' + detail : ''}`);
  }
  const j = await r.json();
  const out = j.image || j.output || j.url;
  if (!out) throw new Error('Endpoint returned no image');
  if (typeof out === 'string' && out.startsWith('http')) {
    const b = await (await fetch(out)).blob();
    return await new Promise(res => { const fr = new FileReader(); fr.onload = () => res(fr.result); fr.readAsDataURL(b); });
  }
  return out;
}

