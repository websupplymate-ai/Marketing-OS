const MASTER_COLS = ['SKU', 'Product Name', 'Group', 'Primary Industry', 'Also Sold To',
  'Product Type', 'Fit', 'Base Colour', 'Fabric Composition', 'GSM',
  'Description', 'Price', 'MOQ', 'Image Drive Link', 'Status', 'Updated At'];

function masterRowFromSku(r) {
  const ind = S.sku.industries.find(i => i.code === r.ind) || {};
  const t = S.sku.types.find(x => x.code === r.type) || {};
  const c = S.sku.colours.find(x => x.code === r.colour) || {};
  const f = S.sku.fits.find(x => x.code === r.fit) || {};
  const prev = S.master.find(m => m.sku === r.code) || {};
  return {
    sku: r.code, name: r.name, group: ind.group || '', industry: ind.label || '',
    also: (r.also || []).join(' '), type: t.label || '', fit: f.label || '',
    colour: c.label || '', fabric: prev.fabric || '', gsm: prev.gsm || '',
    description: prev.description || '', price: prev.price || '', moq: prev.moq || '',
    image: prev.image || '', status: prev.status || 'draft',
    updated: new Date().toISOString().slice(0, 10)
  };
}

async function masterPull() {
  const url = S.cfg.sheetUrl;
  if (!url) return toast('Paste your Apps Script URL first');
  $('mState').className = 'badge amber'; $('mState').textContent = 'Pulling…';
  try {
    const r = await fetch(url + (url.includes('?') ? '&' : '?') + 'action=read');
    const j = await r.json();
    if (!j.ok) throw new Error(j.error || 'Sheet returned an error');
    const incoming = j.rows || [];
    // SKU is the key: update what matches, add what's new, never drop local rows.
    const byKey = {};
    S.master.forEach(m => { byKey[m.sku] = m; });
    incoming.forEach(m => { byKey[m.sku] = { ...byKey[m.sku], ...m }; });
    S.master = Object.values(byKey);
    await persist(); renderMaster();
    $('mState').className = 'badge green';
    $('mState').textContent = `${incoming.length} pulled`;
    toast(`${incoming.length} products pulled`);
  } catch (e) {
    $('mState').className = 'badge red';
    $('mState').textContent = e.message.slice(0, 40);
  }
}

async function masterPush() {
  const url = S.cfg.sheetUrl;
  if (!url) return toast('Paste your Apps Script URL first');
  // Anything coded in the SKU tab but not yet in the master gets seeded first.
  S.sku.rows.forEach(r => {
    if (!S.master.some(m => m.sku === r.code)) S.master.push(masterRowFromSku(r));
  });
  $('mState').className = 'badge amber'; $('mState').textContent = 'Pushing…';
  try {
    const r = await fetch(url, {
      method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify({ action: 'write', products: S.master, syncedAt: new Date().toString() })
    });
    const j = await r.json();
    if (!j.ok) throw new Error(j.error || 'Sheet returned an error');
    await persist(); renderMaster();
    $('mState').className = 'badge green';
    $('mState').textContent = `${S.master.length} pushed`;
    toast(`${S.master.length} products pushed`);
  } catch (e) {
    $('mState').className = 'badge red';
    $('mState').textContent = e.message.slice(0, 40);
  }
}

function renderMaster() {
